classDiagram
    class PawPal {
        +List~Owner~ owners
        +add_owner(name) Owner
        +get_owners() List~Owner~
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +int daily_available_minutes
        +List~str~ preferences
        +add_pet(name, pet_type, age) Pet
        +get_pets() List~Pet~
        +get_all_tasks() List~Task~
    }

    class Pet {
        +str name
        +str pet_type
        +int age
        +Owner owner
        +Schedule schedule
        +edit_info(name, pet_type, age) void
        +add_task(task) void
        +edit_task(task, updates) void
        +remove_task(task) void
        +get_tasks() List~Task~
    }

    class Schedule {
        +Set~str~ EDITABLE_FIELDS$
        +Pet pet
        +List~Task~ tasks
        +get_task(task) Task
        +add_task(task) void
        +edit_task(task, updates) void
        +remove_task(task) void
        +get_tasks() List~Task~
        +filter_tasks(name, category, priority, duration, completed, date) List~Task~
        +daily_display(date) List~Task~
        +weekly_display(start_date) Dict~date, List~Task~~
        +monthly_display(month, year) Dict~date, List~Task~~
    }

    class Task {
        +str id
        +str name
        +str category
        +date date
        +time start_time
        +time end_time
        +int priority
        +str comment
        +str recurrence
        +Set~date~ completed_dates
        +Pet pet
        +List~str~ CATEGORIES$
        +List~str~ RECURRENCES$
        +int MIN_PRIORITY$
        +int MAX_PRIORITY$
        +validate() void
        +get_duration() float
        +occurs_on(date) bool
        +is_complete(on) bool
        +mark_complete(on) void
    }

    class Scheduler {
        +Owner owner
        +daily_plan(date) List~Task~
        +sort_tasks(date, by) List~Task~
        +find_conflicts(date) List~Tuple~Task, Task~~
        +remaining_minutes(date) float
    }

    PawPal "1" *-- "0..*" Owner : contains
    Owner "1" *-- "0..*" Pet : owns
    Owner ..> Task : collects
    Pet "0..*" --> "1" Owner : belongs to
    Pet "1" *-- "1" Schedule : has
    Schedule "1" --> "1" Pet : for
    Schedule "1" o-- "0..*" Task : contains
    Task "0..*" --> "1" Pet : for
    Scheduler "1" --> "1" Owner : plans for
